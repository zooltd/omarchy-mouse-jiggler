#!/usr/bin/env bash
# Toggle a one-pixel pointer nudge so idle timers and apps stay awake.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators"
STATE_FILE="$STATE_DIR/mouse-jiggler"
INTERVAL="${MOUSE_JIGGLER_INTERVAL:-25}"

usage() {
  echo "Usage: omarchy-mouse-jiggler [toggle|on|off|status|run]" >&2
  exit 1
}

enabled() {
  [[ -f $STATE_FILE ]]
}

notify_shell() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell -q youhan.mouse-jiggler refresh || true
}

print_status() {
  if enabled; then
    printf '{"enabled":true,"class":"enabled","tooltip":"Stop mouse jiggler"}\n'
  else
    printf '{"enabled":false,"class":"disabled","tooltip":"Start mouse jiggler"}\n'
  fi
}

set_enabled() {
  mkdir -p "$STATE_DIR"
  if [[ $1 == on ]]; then
    touch "$STATE_FILE"
  else
    rm -f "$STATE_FILE"
  fi
}

read_cursor() {
  local raw x y
  raw="$(hyprctl cursorpos 2>/dev/null || true)"
  raw="${raw// /}"
  x="${raw%%,*}"
  y="${raw##*,}"
  if [[ $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ ]]; then
    printf '%s %s\n' "$x" "$y"
    return 0
  fi
  return 1
}

nudge_pointer() {
  local x y
  if ! read -r x y < <(read_cursor); then
    return 0
  fi
  hyprctl dispatch movecursor "$((x + 1))" "$y" >/dev/null 2>&1 || true
  sleep 0.08
  hyprctl dispatch movecursor "$x" "$y" >/dev/null 2>&1 || true
}

run_loop() {
  mkdir -p "$STATE_DIR"
  touch "$STATE_FILE"
  notify_shell
  while [[ -f $STATE_FILE ]]; do
    nudge_pointer
    sleep "$INTERVAL"
  done
}

case "${1:-toggle}" in
  toggle)
    if enabled; then set_enabled off; else set_enabled on; fi
    notify_shell
    print_status
    ;;
  on|start|enable)
    set_enabled on
    notify_shell
    print_status
    ;;
  off|stop|disable)
    set_enabled off
    notify_shell
    print_status
    ;;
  status|--status)
    print_status
    ;;
  run)
    run_loop
    ;;
  *)
    usage
    ;;
esac
